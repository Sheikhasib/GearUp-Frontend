# Only accessible from the server components / server functions
# Base URL of the deployed GearUp backend API
BACKEND_API_URL=http://localhost:4000

# Accessible from the client & server components / server functions
# Must match BACKEND_API_URL (exposed client-side for public data calls)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000

# JWT secrets used by the Next.js middleware (proxy.ts) to verify tokens.
# MUST match the backend's JWT_ACCESS_SECRET / JWT_REFRESH_SECRET exactly,
# otherwise every token is rejected and all dashboard routes redirect to /login.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Cloudinary cloud name used by next-cloudinary for gear image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
